# === LLM API ===
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Milvus ===
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=insurance_clauses

# === MySQL ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=insurance_platform

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === 模型路径 ===
# BGE-M3 Embedding（HuggingFace 模型名或本地路径）
BGE_M3_MODEL_PATH=BAAI/bge-m3
# BGE Reranker（HuggingFace 模型名或本地路径）
RERANKER_MODEL_PATH=BAAI/bge-reranker-large
# BERT 意图分类预训练模型（HuggingFace 模型名或本地路径）
BERT_CLASSIFIER_PATH=bert-base-chinese
# BERT 微调后模型输出目录（训练后自动填充，无需手动设置）
BERT_MODEL_DIR=models/bert_intent

# === MinIO (原始 PDF) ===
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=insurance-docs
